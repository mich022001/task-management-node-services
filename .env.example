NODE_ENV=development
PORT=3000

LARAVEL_API_URL=http://localhost:8000/api/v1
LARAVEL_INTERNAL_API_URL=http://localhost:8000/api/v1/internal
LARAVEL_SERVICE_KEY=
LARAVEL_TIMEOUT=5000
LARAVEL_RETRY_ATTEMPTS=2
LARAVEL_RETRY_DELAY=300

JWT_SECRET=replace-with-a-secret-at-least-32-characters

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Task Management Platform"
SMTP_FROM_EMAIL=no-reply@example.com

CACHE_TTL_SECONDS=3600
CRON_TIMEZONE=Asia/Manila

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
